              "name": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "procedure": {
                "type": "string"
              },
              "expected_result": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "result_image": {
                "type": "string"
              },
              "execution_status": {
                "type": "string",
                "enum": [
                  "",
                  "not_recorded",
                  "not_executed",
                  "passed",
                  "failed"
